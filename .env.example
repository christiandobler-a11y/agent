# Kopie als .env anlegen. Echte Werte nie committen.
NODE_ENV=development
LOG_LEVEL=info

# Datenbank: genau EINE Zeile ohne # am Anfang. Zeilen mit # sind Kommentare und werden ignoriert.
# Supabase: Connect → "Session pooler" (IPv4, Port 5432), Passwort einsetzen. Nicht den Transaction-Pooler
# (6543) nehmen, die Job-Queue (pg-boss) braucht Session-Features. Kein ?sslmode anhängen (TLS erzwingt die App).
# Anleitung: docs/SUPABASE.md
DATABASE_URL=postgresql://postgres.<projekt-ref>:<passwort>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# Lokal (docker compose up -d db) stattdessen:
# DATABASE_URL=postgres://avelio:avelio@localhost:5432/avelio

# Nur für Tests mit echter Datenbank (npm test). Ohne diese Variable werden DB-Tests lokal übersprungen.
TEST_DATABASE_URL=postgres://avelio:avelio@localhost:5432/avelio_test

# LLM (Prefilter, Audit, Pitch, Manager)
# In Claude-Code-Cloud-Sessions stattdessen AVELIO_ANTHROPIC_API_KEY setzen (der Standardname wird dort gefiltert).
ANTHROPIC_API_KEY=

# Google Cloud: Places API (New) + PageSpeed Insights, ein Key auf diese 2 APIs beschränkt
GOOGLE_API_KEY=

# Telegram (@BotFather) + erlaubte Chat-IDs, kommagetrennt
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Crawl: Chromium kommt über "npx playwright install chromium". Nur setzen, wenn ein anderer Chromium genutzt
# werden soll (z. B. in Claude-Code-Cloud-Sessions: /opt/pw-browsers/chromium).
# CHROMIUM_PATH=


# Betrieb auf dem Server (docs/DEPLOY.md): optionale Ping-URL von healthchecks.io für den Ausfall-Alarm
# HEALTHCHECK_URL=

# Kontakt-Entwürfe (Telegram: Kontakt → ✍️ E-Mail-Entwurf). WhatsApp-Business-Nummer international, Telefon für die
# Signatur. Texte, Termine und Regeln stehen in config/outreach.yaml.
# OUTREACH_WHATSAPP=+49 151 …
# OUTREACH_PHONE=0151 …
# Optional: fester Link für das kurze Video-Gespräch (steht dann in der Termin-Bestätigung), sonst rufst du an
# OUTREACH_MEETING_URL=https://meet.google.com/…
# Optional: deine Geschäftsanschrift für Angebote (eine Zeile)
# AVELIO_ANSCHRIFT=Musterstraße 1, 82380 Peißenberg
