# Kopie als .env anlegen. Echte Werte nie committen.
NODE_ENV=development
LOG_LEVEL=info

# Lokal: docker compose up -d db
DATABASE_URL=postgres://avelio:avelio@localhost:5432/avelio

# LLM (Prefilter, Audit, Pitch, Manager)
ANTHROPIC_API_KEY=

# Google Cloud: Places API (New) + PageSpeed Insights, ein Key auf diese 2 APIs beschränkt
GOOGLE_API_KEY=

# Telegram (@BotFather) + erlaubte Chat-IDs, kommagetrennt
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
