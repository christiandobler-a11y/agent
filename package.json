{
  "name": "avelio",
  "version": "0.1.0",
  "private": true,
  "description": "Avelio Lead Engine: lokale Unternehmen finden, Websites auditieren, Leads bewerten.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/cli.ts",
    "check-env": "tsx src/cli.ts check-env",
    "migrate": "tsx src/cli.ts migrate",
    "db-status": "tsx src/cli.ts db-status",
    "costs": "tsx src/cli.ts costs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "cheerio": "^1.2.0",
    "grammy": "^1.46.0",
    "imapflow": "^2.2.2",
    "lucide-static": "^1.51.0",
    "mailparser": "^3.9.33",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
